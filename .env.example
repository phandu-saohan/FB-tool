# Database configuration (Default: SQLite for instant ready-to-run, change to MySQL 8 when ready)
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/facebook_automation
DATABASE_URL=sqlite:///./data/facebook_automation.db
FALLBACK_TO_SQLITE=true

# AI Configuration (gemini | openai | openrouter)
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Facebook Browser Automation
FACEBOOK_PROFILE_PATH=./profiles/facebook
BROWSER_HEADLESS=false
CHROME_EXECUTABLE_PATH=

# Rate Limiting & Safety Delays (Seconds)
POST_DELAY_MIN=60
POST_DELAY_MAX=180
MAX_POSTS_PER_RUN=10

# Server Config
HOST=127.0.0.1
PORT=8080
